# Local Expo Go / Metro — auto-detects LAN host. Do NOT put VPS URL here.
EXPO_PUBLIC_API_PORT=5001

# Optional: force your Mac LAN IP if auto-detect fails (same Wi‑Fi as phone).
# EXPO_PUBLIC_DEV_API_HOST=192.168.1.x

# Google sign-in: same Web client ID as Backend GOOGLE_WEB_CLIENT_ID (Metro restart after changing).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# Optional tunnel for local testing only (ngrok). Leave commented for normal local.
# EXPO_PUBLIC_API_URL=https://your-tunnel.example.com
