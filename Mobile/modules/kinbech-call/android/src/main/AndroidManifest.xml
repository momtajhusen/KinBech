<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <application>
    <service
      android:name="expo.modules.kinbechcall.IncomingCallService"
      android:exported="false"
      android:foregroundServiceType="phoneCall" />
    <activity
      android:name="expo.modules.kinbechcall.IncomingCallActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTop"
      android:taskAffinity="${applicationId}.incomingcall"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:screenOrientation="portrait"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
      android:theme="@style/KinBechIncomingCallTheme" />
    <receiver
      android:name="expo.modules.kinbechcall.CallActionReceiver"
      android:exported="false" />
    <service
      android:name="expo.modules.kinbechcall.CallDeclineService"
      android:exported="false" />
    <receiver
      android:name="expo.modules.kinbechcall.CallPushReceiver"
      android:exported="true"
      android:permission="com.google.android.c2dm.permission.SEND">
      <intent-filter>
        <action android:name="com.google.android.c2dm.intent.RECEIVE" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
