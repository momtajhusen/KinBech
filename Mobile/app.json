{
  "expo": {
    "name": "KinBech",
    "slug": "kinbech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codersalpha.kinbech",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KinBech uses your location while the app is open to show nearby listings and auto-fill your city or district when you choose.",
        "NSCameraUsageDescription": "KinBech uses the camera when you take listing photos or record a short product video.",
        "NSMicrophoneUsageDescription": "KinBech uses the microphone for voice search, voice calls, and short listing videos.",
        "NSSpeechRecognitionUsageDescription": "KinBech turns your speech into a search so you can find items by speaking.",
        "NSPhotoLibraryUsageDescription": "KinBech needs access to your photo library so you can upload profile and listing images.",
        "NSPhotoLibraryAddUsageDescription": "KinBech may save edited listing photos back to your library when you choose to export them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#00000000"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.codersalpha.kinbech",
      "googleServicesFile": "./google-services.json",
      "newArchEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icons/app-icon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "KinBech needs photo library access so you can upload listing and profile images.",
          "cameraPermission": "KinBech uses the camera when you take listing photos or record a short product video (max 30 seconds)."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KinBech uses the camera when you take listing photos or record a short product video.",
          "microphonePermission": "KinBech uses the microphone for voice search, voice calls, and short listing videos.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow KinBech to use your location while the app is open to show nearby listings and auto-fill city or district.",
          "locationWhenInUsePermission": "Allow KinBech to use your location while the app is open to show nearby listings and auto-fill city or district.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F17",
          "image": "./assets/icons/app-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.codersalpha.kinbech.** { *; }\n-dontwarn com.google.mlkit.vision.**"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "KinBech uses the microphone for voice calls with buyers and sellers, and while you record a short listing video.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/withIncomingCall",
      "./plugins/withCertificatePinning",
      "./plugins/withGradleMemory",
      "./plugins/withAgoraSlim",
      "./plugins/withReleaseSigning",
      "./plugins/withReleaseSigning",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "KinBech uses the microphone for voice search, voice calls, and short listing videos.",
          "speechRecognitionPermission": "KinBech turns your speech into a search so you can find items by speaking.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-status-bar",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Nunito",
                "fontDefinitions": [
                  { "path": "./assets/fonts/nunito_regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/nunito_medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/nunito_semibold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/nunito_bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/nunito_extrabold.ttf", "weight": 800 },
                  { "path": "./assets/fonts/nunito_black.ttf", "weight": 900 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/nunito_regular.ttf",
              "./assets/fonts/nunito_medium.ttf",
              "./assets/fonts/nunito_semibold.ttf",
              "./assets/fonts/nunito_bold.ttf",
              "./assets/fonts/nunito_extrabold.ttf",
              "./assets/fonts/nunito_black.ttf"
            ]
          }
        }
      ],
      "expo-video",
      "expo-secure-store"
    ]
  }
}
