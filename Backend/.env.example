PORT=5001
MONGODB_URI=mongodb+srv://cluster0.lmpu96b.mongodb.net/KinBech?retryWrites=true&w=majority&appName=Cluster0
MONGODB_USER=<db_username>
MONGODB_PASSWORD=<db_password>
MONGODB_DB_NAME=KinBech
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=5
DEFAULT_OTP=1111
NODE_ENV=development
CLIENT_ORIGIN=*

# Error monitoring (optional — admin Error Log works without this)
# Create a project at https://sentry.io and paste the DSN:
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_RELEASE=kinbech-api@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Keep media outside the git repo so deploy/pull never deletes uploads:
# UPLOADS_DIR=/var/kinbech/uploads

# NSFW image auto-detect on upload (nsfwjs). Default: enabled.
# NSFW_ENABLED=true
# NSFW_FAIL_OPEN=true
# NSFW_PORN_THRESHOLD=0.55
# NSFW_HENTAI_THRESHOLD=0.55
# NSFW_SEXY_THRESHOLD=0.78

# Local `make run` uses this first in development (Atlas only if local fails):
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/KinBech
